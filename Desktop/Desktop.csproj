<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Title>Îakaré Software'Oka - Desktop Library</Title>
    <Authors>Îakaré Software'Oka</Authors>
    <PackageProjectUrl>https://github.com/luca16s/IakareLibraries</PackageProjectUrl>
    <Copyright>$(Authors)</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/luca16s/IakareLibraries</RepositoryUrl>
    <PackageId>ISO.$(AssemblyName)</PackageId>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <Version>$(VersionPrefix)</Version>
  </PropertyGroup>

</Project>
